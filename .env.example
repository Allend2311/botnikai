# ==========================================================
#  Discord
# ==========================================================
# Bot token  ->  Discord Developer Portal > Bot > Reset Token
DISCORD_TOKEN=your-bot-token
# Application ID -> Discord Developer Portal > General Information
DISCORD_CLIENT_ID=your-application-id
# Client secret -> Developer Portal > OAuth2 > General
DISCORD_CLIENT_SECRET=your-client-secret
# Application ID (used to register slash commands globally)
DISCORD_APPLICATION_ID=your-application-id
# Discord user id(s) allowed to run owner-only commands such as /broadcast
# and open the owner pages on the website. Comma or space separated.
# Leave empty to fall back to the Discord application/team owner.
BOT_OWNER_IDS=
# ==========================================================
#  Database (Prisma Postgres)
# ==========================================================
# Copy the connection string from your Prisma Postgres project.
DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"

# Use a direct connection here if your project provides one for migrations.
# The pooled URL also works for this project's current Prisma Postgres database.
DIRECT_URL="${DATABASE_URL}"

# ==========================================================
#  Website
# ==========================================================
# Public URL of the website. It must match the OAuth2 redirect URL
# (<APP_URL>/api/auth/callback) that is registered in the developer portal.
# Use the origin only - no trailing slash.
APP_URL=http://localhost:3000

# Welcome and farewell uploads are stored in the configured PostgreSQL database.

# ==========================================================
#  Optional
# ==========================================================
NODE_ENV=development
